# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# TransactPay Configuration (TEST & LIVE MODES)
# Set TRANSACTPAY_ENV to 'test' or 'live'
TRANSACTPAY_ENV=test
TRANSACTPAY_API_URL=https://payment-api-service.transactpay.ai
TRANSACTPAY_PUBLIC_KEY=
TRANSACTPAY_SECRET_KEY=
TRANSACTPAY_ENCRYPTION_KEY=
TRANSACTPAY_WEBHOOK_SECRET=

# Primary Email Provider: Resend
RESEND_API_KEY=re_your_api_key_here

# Fallback Email Provider: Brevo (Sendinblue)
# Note: Keep BREVO_API_KEY server-side only. Do NOT prefix with NEXT_PUBLIC_
BREVO_API_KEY=

# Multi-Provider Routing & Fallback Settings
EMAIL_PRIMARY_PROVIDER=resend
EMAIL_FALLBACK_PROVIDER=brevo
EMAIL_ENABLE_FALLBACK=true

# Sender Addresses
EMAIL_FROM_RECEIPTS="JVican Receipts <receipts@jvican.com>"
EMAIL_FROM_NOTIFICATIONS="JVican Notifications <notifications@jvican.com>"
EMAIL_FROM_NEWSLETTER="JVican Newsletter <newsletter@jvican.com>"

# Application Base URL (Domain-agnostic; used for hosted checkout callbacks and receipts)
NEXT_PUBLIC_APP_URL=http://localhost:3000
